<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown for the brief native-window gap before Flutter's own splash
         screen (features/splash/splash_screen.dart) takes over — kept a
         plain solid dark background matching AppColors.backgroundDark so
         there's no visible flash/mismatch between the two. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
